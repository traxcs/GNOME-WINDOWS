<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection (19041) gives access to the official WinRT APIs we use:
         Windows.Devices.Radios, Windows.Networking.Connectivity, UserNotificationListener. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!-- Framework-dependent dev builds also run on a newer installed .NET (published builds are self-contained). -->
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GnomeWin</RootNamespace>
    <AssemblyName>GnomeWin</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GnomeWin.ico</ApplicationIcon>
    <StartupObject>GnomeWin.Program</StartupObject>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</PlatformTarget>
    <Version>1.0.0</Version>
    <Product>GnomeWin</Product>
    <Company>GnomeWin</Company>
    <Description>GNOME Shell experience for Windows 11</Description>
    <Copyright>MIT License</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <!-- A shell allocates little: non-concurrent workstation GC + memory conservation keep the footprint small. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- App.xaml is compiled as a Page: we provide our own Main (Program.cs) so the same
       executable can also run as watchdog / restore tool without starting WPF. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GnomeWin.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <None Include="Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GnomeWin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

</Project>
