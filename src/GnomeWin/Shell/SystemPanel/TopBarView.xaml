<UserControl x:Class="GnomeWin.Shell.SystemPanel.TopBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:GnomeWin.UI"
             Height="32" Background="{DynamicResource Brush.PanelBg}" Focusable="False"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <!-- Ubuntu top bar buttons: pill highlight on hover / when their menu is open -->
        <Style x:Key="PanelButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.PanelFg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="2,3" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Radius = half the button height (26 px): a real pill, not an ellipse -->
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="13" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PanelHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.PanelFg}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Activities: workspace indicator pill (GNOME 46 / Ubuntu 24.04) -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Button x:Name="ActivitiesButton" Style="{StaticResource PanelButton}" Margin="6,3" Padding="10,0"
                    ToolTip="{ui:Tr Activities}" AutomationProperties.Name="{ui:Tr Activities}">
                <StackPanel x:Name="WorkspaceDots" Orientation="Horizontal" VerticalAlignment="Center" />
            </Button>
            <TextBlock x:Name="SafeModeLabel" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Warning}" FontSize="12" Visibility="Collapsed" Text="SAFE MODE" FontWeight="Bold" />
        </StackPanel>

        <!-- GNOME hot corner: 3x3 px in the top-left corner of the screen -->
        <Border x:Name="HotCornerZone" Width="2" Height="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="#01000000" Panel.ZIndex="10" />

        <!-- Clock / calendar / notifications -->
        <Button x:Name="ClockButton" Grid.Column="1" Style="{StaticResource PanelButton}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ClockText" VerticalAlignment="Center" />
                <Ellipse x:Name="NotificationDot" Width="6" Height="6" Fill="{DynamicResource Brush.PanelFg}" Margin="8,0,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Button>

        <!-- System status (GNOME): network (Wi-Fi or wired), volume, battery on laptops -->
        <Button x:Name="StatusButton" Grid.Column="2" Style="{StaticResource PanelButton}" HorizontalAlignment="Right" Margin="0,3,6,3">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="NetworkGlyph" Style="{StaticResource PanelGlyph}" Text="&#xE701;" />
                <TextBlock x:Name="VolumeGlyph" Style="{StaticResource PanelGlyph}" Text="&#xE767;" />
                <TextBlock x:Name="BatteryGlyph" Style="{StaticResource PanelGlyph}" Text="&#xEBAA;" Visibility="Collapsed" />
                <TextBlock x:Name="BatteryText" VerticalAlignment="Center" FontSize="13" Margin="0,0,4,0" Visibility="Collapsed" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
